# Validates one shader exactly as the runtime assembles it, as GLSL ES 3.00 (TECH_SPEC 5.1).
get_filename_component(name ${IN} NAME)
if(name MATCHES "\\.vert$")
  set(stage vert)
else()
  set(stage frag)
endif()
file(READ ${SHADERS}/prelude_${stage}.glsl pstage)
file(READ ${SHADERS}/prelude.glsl pcommon)
file(READ ${IN} body)
get_filename_component(dir ${OUT} DIRECTORY)
file(MAKE_DIRECTORY ${dir})
file(WRITE ${OUT} "#version 300 es\n${pstage}${pcommon}${body}")
execute_process(COMMAND ${GLSLANG} -S ${stage} ${OUT} RESULT_VARIABLE rc OUTPUT_VARIABLE log ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "shader ${name} is not valid GLSL ES 3.00:\n${log}${err}")
endif()
file(WRITE ${STAMP} "ok\n")
