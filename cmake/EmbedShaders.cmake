# Embeds every shaders/*.glsl, *.vert and *.frag as a raw string literal: {"name", R"GTGLSL(...)GTGLSL"},
# The runtime (src/gfx/shader.cpp) assembles: version line + prelude_<stage>.glsl + prelude.glsl + body.
file(GLOB files ${SHADERS}/*.glsl ${SHADERS}/*.vert ${SHADERS}/*.frag)
list(SORT files)
set(out "// Generated by cmake/EmbedShaders.cmake - do not edit.\n")
foreach(f ${files})
  get_filename_component(name ${f} NAME)
  file(READ ${f} text)
  string(FIND "${text}" ")GTGLSL" bad)
  if(NOT bad EQUAL -1)
    message(FATAL_ERROR "${name} contains the raw-string delimiter")
  endif()
  string(APPEND out "{\"${name}\", R\"GTGLSL(${text})GTGLSL\"},\n")
endforeach()
file(WRITE ${OUT}.tmp "${out}")
execute_process(COMMAND ${CMAKE_COMMAND} -E copy_if_different ${OUT}.tmp ${OUT})
